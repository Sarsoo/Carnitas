<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
      <PackageReference Include="Grpc.Tools" Version="2.84.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="proto\agent.proto" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Carnitas\Carnitas.csproj" />
    </ItemGroup>

</Project>
