{
  "Kestrel": {
    "Endpoints": {
      "Web": {
        "Url": "http://localhost:5000",
        "Protocols": "Http1"
      },
      "gRPC": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NLog": {
    "rules": [
      {
        "final": true,
        "logger": "Microsoft.AspNetCore.*",
        "maxLevel": "Info"
      },
      {
        "final": true,
        "logger": "System.Net.Http.*",
        "maxLevel": "Off"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      }
    ],
    "targets": {
      "async": true,
      "logconsole": {
        "type": "ColoredConsole"
      }
    },
    "throwConfigExceptions": true
  },
  "AllowedHosts": "*"
}
