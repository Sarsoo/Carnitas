@page "/Repo/{id}"
@using Carnitas.Model
@using Carnitas.Model.Operations
@using Carnitas.Model.Source
@using Carnitas.Model.Source.SourceControl
@using Carnitas.Web.Components.Tasks.Dialog
@using Carnitas.Web.Extensions
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudStack Row="true">
    <h3>Repository</h3>
    <MudSpacer/>
    <FontAwesomIcon Specifiers="brands,git-alt,2xl"/>
</MudStack>

@if (repo is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add" OnClick="EnqueueAsync">Enqueue Task</MudButton>

    <MudTabs Elevation="2" Rounded="true" Position="Position.Start" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" ActivePanelIndex="@TabIndex" ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <RepoOverviewCard Repository=@repo />
        </MudTabPanel>
        <MudTabPanel Text="Modules">
            <RepoModuleTable RepositoryId="@Id" @ref="repoModule"/>
        </MudTabPanel>
        <MudTabPanel Text="Drift">
            <MudText>Coming soon</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Settings">
            <RepoSettingsCard Repository=@repo Saved="@(() => repoModule?.Reload())" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private Repository? repo;
    private RepoModuleTable? repoModule;

    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo($"/Repo/{Id}?tabIndex={index}");
    }

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => repo?.ToBreadrumbs() ?? new List<BreadcrumbItem>();
    
    protected override async Task OnInitializedAsync()
    {
        repo = await Db.Repository.FindAsync([Id]);

        if (repo is not null)
        {
            repo.Organisation = await Db.Organisations.FindAsync([repo!.OrganisationId]);
        }
    }

    private async Task EnqueueAsync()
    {
        if (repo is null)
        {
            return;
        }

        var parameters = new DialogParameters<NewTaskDialog>
        {
            { x => x.RepositoryId, repo.Id }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<NewTaskDialog>("Enqueue Task", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not QueuedTask task)
        {
            return;
        }

        Navigation.NavigateTo($"/Task/{task.Id}");
    }
}
