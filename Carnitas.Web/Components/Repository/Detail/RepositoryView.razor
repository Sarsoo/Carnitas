@page "/Repo/{id}"
@using Carnitas.Model
@using Carnitas.Model.Operations
@using Carnitas.Model.Source
@using Carnitas.Model.Source.SourceControl
@using Carnitas.Web.Components.Tasks
@using Carnitas.Web.Components.Tasks.Dialog
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IDialogService DialogService

<h3>Repository</h3>

@if (repo is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="breadcrumbs"></MudBreadcrumbs>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add" OnClick="EnqueueAsync">Enqueue Task</MudButton>

    <MudTabs Elevation="2" Rounded="true" Position="Position.Start" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <MudTabPanel Text="Overview">
            <RepoOverviewCard Repository=@repo />
        </MudTabPanel>
        <MudTabPanel Text="Root Modules">
            <MudDataGrid @ref="_elementGrid" T="Module" Items="RootModules" RowClick="OnRowClick" Hover="true" Dense="true" RowClass="cursor-pointer">
                <Columns>
                    <PropertyColumn Property="r => r.Name"/>
                    <TemplateColumn>
                        <CellTemplate>
                            @{ var moduleLink = $"/Repo/{repo.Id}/Module/{context.Item.Id}"; }
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                           Href=@moduleLink />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Module" />
                </PagerContent>
            </MudDataGrid>
        </MudTabPanel>
        <MudTabPanel Text="Drift">
            <MudText>Coming soon</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Settings">
            <RepoSettingsCard Repository=@repo Saved="ReloadRepo" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private Repository? repo;

    private List<BreadcrumbItem> breadcrumbs => [
        new(repo?.Organisation?.Name, $"/Org/{repo.OrganisationId}", icon: Icons.Material.Filled.Domain),
    ];

    private MudDataGrid<Module> _elementGrid = null!;
    private IQueryable<Module> RootModules => Db.Repository
        .Where(r => r.Id == Id)
        .Include(r => r.Modules)
        .SelectMany(r => r.Modules);
    
    void OnRowClick(DataGridRowClickEventArgs<Module> args)
    {
        Navigation.NavigateTo($"/Repo/{repo!.Id}/Module/{args.Item.Id}");
    }

    protected override async Task OnInitializedAsync()
    {
        repo = await Db.Repository.FindAsync([Id]);
        repo.Organisation = await Db.Organisations.FindAsync([repo.OrganisationId]);
    }

    private async Task ReloadRepo()
    {
        await _elementGrid.ReloadServerData();
    }

    private async Task EnqueueAsync()
    {
        if (repo is null)
        {
            return;
        }

        var parameters = new DialogParameters<NewTaskDialog>
        {
            { x => x.RepositoryId, repo.Id }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<NewTaskDialog>("Enqueue Task", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not QueuedTask task)
        {
            return;
        }

        Navigation.NavigateTo($"/Task/{task.Id}");
    }
}
