@page "/Repo/{id}"
@using Carnitas.Web.Components.Operations.Tasks.Dialog
@using Carnitas.Web.Components.Operations.Tasks.Shared
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudStack Row="true">
    <h3>Repository</h3>
    <MudSpacer/>
    <FontAwesomeIcon Specifiers="brands,git-alt,2xl"/>
</MudStack>

@if (_repo is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add" OnClick="EnqueueAsync">Enqueue Task</MudButton>

    <MudTabs Elevation="2" 
             Rounded="true" 
             Position="Position.Start" 
             ApplyEffectsToContainer="true" 
             TabPanelsClass="px-6" 
             ActivePanelIndex="@TabIndex" 
             ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <RepoOverviewCard Repository=@_repo />
        </MudTabPanel>
        <MudTabPanel Text="Modules" Icon="@Constants.ModuleIcon">
            <RepoModuleTab RepositoryId="@Id" @ref="_repoModule"/>
        </MudTabPanel>
        <MudTabPanel Text="Operations" Icon="@Constants.OpIcon">
            <OperationsTable 
                IncludeModule="true"
                Filter="tasks => tasks.Where(x => x.RepositoryId == Id)" />
        </MudTabPanel>
        <MudTabPanel Text="Drift" Icon="@Constants.DriftIcon">
            <MudText>Coming soon</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Settings" Icon="@Constants.SettingsIcon">
            <RepoSettingsCard Repository=@_repo Saved="@(() => _repoModule?.Reload())" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public required string Id { get; set; }

    private Repository? _repo;
    private RepoModuleTab? _repoModule;

    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo($"/Repo/{Id}?tabIndex={index}");
    }

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => _repo?.ToBreadrumbs() ?? new List<BreadcrumbItem>();
    
    protected override async Task OnInitializedAsync()
    {
        _repo = await Db.Repository.FindAsync([Id]);

        if (_repo is not null)
        {
            _repo.Organisation = await Db.Organisations.FindAsync([_repo!.OrganisationId]);
        }
    }

    private async Task EnqueueAsync()
    {
        if (_repo is null)
        {
            return;
        }

        var parameters = new DialogParameters<NewTaskDialog>
        {
            { x => x.RepositoryId, _repo.Id }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<NewTaskDialog>("Enqueue Task", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not QueuedTask task)
        {
            return;
        }

        Navigation.NavigateTo($"/Task/{task.Id}");
    }
}
