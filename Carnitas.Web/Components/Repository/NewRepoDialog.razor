@using Carnitas.Model
@using Carnitas.Model.Governance
@using Carnitas.Model.Source.SourceControl
@using Carnitas.Web.Model
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<MudDialog>
    <TitleContent>
        Add Repository
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem>
                <MudCard>
                    <MudCardContent>
                        <MudTextField Label="Name" @bind-Value="model.Name" For="@(() => model.Name)"/>
                        @if (string.IsNullOrEmpty(OrganisationId))
                        {
                            <MudSelect T="string" Label="Organisation" @bind-Value="_selectedOrgId">
                                @foreach (var org in _organisations)
                                {
                                    <MudSelectItem Value="@org.Id">@org.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        <MudSelect T="RepositoryType" Label="Type" @bind-Value="model.Type" For="@(() => model.Type)">
                            @foreach (var type in Enum.GetValues<RepositoryType>())
                            {
                                <MudSelectItem Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField Label="Git URL" @bind-Value="model.GitUrl" For="@(() => model.GitUrl)"/>
                        <MudTextField Label="Repository URL (optional)" @bind-Value="model.RepositoryUrl" For="@(() => model.RepositoryUrl)"/>
                        <MudTextField Label="Description" Lines="3" @bind-Value="model.Description" For="@(() => model.Description)"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary"
                   Disabled="@(string.IsNullOrEmpty(OrganisationId) && string.IsNullOrEmpty(_selectedOrgId))"
                   OnClick="@OnSubmit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    NewRepository model = new();

    private List<Organisation> _organisations = new();
    private string? _selectedOrgId;

    [Parameter]
    public string? OrganisationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(OrganisationId))
        {
            _organisations = await DbContext.Organisations
                .OrderBy(o => o.Name)
                .ToListAsync();
        }
    }

    private async Task OnSubmit()
    {
        var repo = new Repository
        {
            Id = Guid.NewGuid().ToString(),
            Name = model.Name,
            Type = model.Type,
            GitUrl = model.GitUrl,
            RepositoryUrl = model.RepositoryUrl,
            OrganisationId = string.IsNullOrEmpty(OrganisationId) ? _selectedOrgId! : OrganisationId,
            Description = model.Description ?? ""
        };

        DbContext.Repository.Add(repo);
        await DbContext.SaveChangesAsync();

        MudDialog.Close(DialogResult.Ok(repo));
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Cancel() => MudDialog.Cancel();
}
