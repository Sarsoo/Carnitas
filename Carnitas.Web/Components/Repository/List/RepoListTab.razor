@using Carnitas.Web.Components.Repository.Dialog
@using Microsoft.EntityFrameworkCore
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext

<MudToolBar>
    <MudSpacer />
    <MudButton @onclick="OpenDialogAsync" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Create" Color="Color.Primary">Create</MudButton>
</MudToolBar>
<MudGrid Justify="Justify.Center">
    @foreach (var repo in _repositories)
    {
        var repoHref = $"/Repo/{repo.Id}";
        var orgHref = $"/Org/{repo.OrganisationId}";
        <MudItem>
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">@repo.Name</MudText>
                    <MudSpacer/>
                    @if (repo.Type is RepositoryType.Generic)
                    {
                        <FontAwesomeIcon Icon="@FontAwesome.Git"/>
                    }
                    else if (repo.Type is RepositoryType.GitHub)
                    {
                        <FontAwesomeIcon Icon="@FontAwesome.GitHub"/>
                    }
                </MudCardHeader>
                <MudCardContent>
                    @if (!string.IsNullOrWhiteSpace(repo.Description))
                    {
                        <MudText Typo="Typo.body2">@repo.Description</MudText>
                    }
                    @* <MudLink Href=@orgHref>@(repo.Organisation?.Name ?? repo.OrganisationId)</MudLink> *@
                </MudCardContent>
                <MudCardActions>
                    <MudButton Class="mx-2" Variant="Variant.Filled" Color="Color.Primary" Href=@repoHref>Open</MudButton>
                    <MudButton Class="mx-2" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Constants.OrgIcon" Href=@orgHref>@(repo.Organisation?.Name ?? repo.OrganisationId)</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {

    private IEnumerable<Repository> _repositories = Enumerable.Empty<Repository>();

    protected override async Task OnInitializedAsync()
    {
        _repositories = await DbContext.Repository
            .Include(r => r.Organisation)
            .OrderBy(r => r.Name)
            .ToListAsync();
    }

    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<NewRepoDialog>("Add Repository", options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not Repository repo)
        {
            return;
        }

        Navigation.NavigateTo(repo.ToLink());
    }
}
