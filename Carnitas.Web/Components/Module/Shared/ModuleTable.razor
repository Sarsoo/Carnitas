@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<MudGrid>
    <MudItem xs="12">
        <MudDataGrid @ref="_elementGrid" T="Module" ServerData="ServerData"
                     FixedHeader="true"
                     RowClick="OnRowClick" 
                     Hover="true" Dense="true" RowClass="cursor-pointer"
                     ReadOnly="false"
                     EditMode="DataGridEditMode.Inline"
                     EditTrigger="DataGridEditTrigger.Manual"
                     StartedEditingItem="@StartedEditingItem"
                     CanceledEditingItem="@CanceledEditingItem"
                     CommittedItemChanges="@CommittedItemChanges">
            <Columns>
                <PropertyColumn Property="r => r.Name" Editable="false" />
                <PropertyColumn Property="r => r.Type">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.Type"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Text"
                                   Dense="true">
                            <MudSelectItem T="ModuleType" Value="Carnitas.Model.Source.ModuleType.Unset">Unset</MudSelectItem>
                            <MudSelectItem T="ModuleType" Value="Carnitas.Model.Source.ModuleType.Root">Root</MudSelectItem>
                            <MudSelectItem T="ModuleType" Value="Carnitas.Model.Source.ModuleType.Library">Library</MudSelectItem>
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                @if (IncludeTrackingBranch)
                {
                    <PropertyColumn Property="r => r.TrackingBranch" Required="false" />
                }
                <PropertyColumn Property="r => r.RelativePath" CellClass="text-mono" Editable="false" InitialDirection="SortDirection.Ascending"/>
                <TemplateColumn Editable="false">
                    <CellTemplate>
                        @if (context.IsEditing)
                        {
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Check"
                                           Color="Color.Success"
                                           aria-label="Save changes"
                                           OnClick="@context.Actions.CommitEditingItemAsync" />
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Error"
                                           aria-label="Cancel editing"
                                           OnClick="@context.Actions.CancelEditingItemAsync" />
                        }
                        else
                        {
                            <MudIconButton Size="Size.Small"
                                           Icon="@Icons.Material.Outlined.Edit"
                                           Disabled="@_isEditing"
                                           aria-label="Edit row"
                                           OnClick="@context.Actions.StartEditingItemAsync" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                       Href=@context.Item.ToLink()/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Module" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>
@code {
    
    [Parameter] public required string RepositoryId { get; set; }
    [Parameter] public ModuleType? ModuleType { get; set; }
    
    [Parameter] public bool IncludeTrackingBranch { get; set; }
    
    private bool _isEditing;
    
    private MudDataGrid<Module> _elementGrid = null!;
    private IEnumerable<Module> _modules = [];

    protected override async Task OnInitializedAsync()
    {
        
    }
    
    private async Task<GridData<Module>> ServerData(GridState<Module> state, CancellationToken token)
    {
        var data = GetQuery()
            .Where(state.FilterDefinitions)
            .OrderBy(state.SortDefinitions);
        
        return new GridData<Module> {
            TotalItems = await data.CountAsync(cancellationToken: token),
            Items = await data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToListAsync(cancellationToken: token)
        };
    }

    private IQueryable<Module> GetQuery()
    {
        var modules = Db.Modules
            .Where(r => r.RepositoryId == RepositoryId)
            .IgnoreAutoIncludes()
            .AsNoTracking();

        if (ModuleType is not null)
        {
            modules = modules.Where(x => x.Type == ModuleType);
        }

        return modules;
    }
    
    void OnRowClick(DataGridRowClickEventArgs<Module> args)
    {
        if (!_isEditing)
        {
            Navigation.NavigateTo(args.ToLink());
        }
    }

    private void OnCellClick(DataGridCellClickEventArgs<Module> args)
    {
        
    }

    public void Reload()
    {
        
    }
    
    private void StartedEditingItem(Module item)
    {
        _isEditing = true;
    }

    private void CanceledEditingItem(Module item)
    {
        _isEditing = false;
    }

    private async Task<DataGridEditFormAction> CommittedItemChanges(Module item)
    {
        // Perform validation
        await Db.Modules
            .Where(x => x.Id == item.Id)
            .ExecuteUpdateAsync(a => a.SetProperty(x => x.Type, item.Type));

        _isEditing = false;
        return DataGridEditFormAction.Close;
    }
}