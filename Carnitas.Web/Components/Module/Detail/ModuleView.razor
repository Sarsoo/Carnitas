@page "/Repo/{repoId}/Module/{id}"
@using Carnitas.Model
@using Carnitas.Model.Source
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>Module</h3>

@if (module is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
    <MudTabs Elevation="2" Rounded="true" Position="Position.Start" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" ActivePanelIndex="@TabIndex" ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <ModuleOverviewCard Module=@module />
        </MudTabPanel>
        <MudTabPanel Text="Operations">
            <OperationsTable Filter="tasks => tasks.Where(x => x.ModuleId == Id)" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string RepoId { get; set; }

    [Parameter]
    public string Id { get; set; }

    private Module? module;

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => module?.ToBreadrumbs() ?? new List<BreadcrumbItem>();
    
    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo(module?.ToLink() + $"?tabIndex={index}");
    }

    protected override async Task OnInitializedAsync()
    {
        module = await Db.Modules
            .AsNoTracking()
            .Include(m => m.Repository)
            .ThenInclude(r => r.Organisation)
            .Include(m => m.OperationRuns)
            .SingleOrDefaultAsync(m => m.Id == Id && m.RepositoryId == RepoId);
    }
}
