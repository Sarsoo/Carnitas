@page "/Repo/{repoId}/Module/{id}"
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>Module</h3>

@if (_module is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudStack Row="true">
        <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
        <MudSpacer/>
        @if (_module?.Type is ModuleType.Root)
        {
            <MudText>Root Module</MudText>
            <MudIcon Icon="@Constants.RootIcon"/>
        }
        else if (_module?.Type is ModuleType.Library)
        {
            <MudText>Library</MudText>
            <MudIcon Icon="@Constants.LibraryIcon"/>
        }
    </MudStack>
    <MudTabs Elevation="2" 
             Rounded="true" 
             Position="Position.Start" 
             ApplyEffectsToContainer="true" 
             TabPanelsClass="px-6" 
             ActivePanelIndex="@TabIndex" 
             ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <ModuleOverviewCard Module=@_module />
        </MudTabPanel>
        <MudTabPanel Text="Operations" Icon="@Constants.OpIcon">
            <OperationsTable Filter="tasks => tasks.Where(x => x.ModuleId == Id)" />
        </MudTabPanel>
        <MudTabPanel Text="Settings" Icon="@Constants.SettingsIcon">
            <ModuleSettingsCard />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public required string RepoId { get; set; }

    [Parameter]
    public required string Id { get; set; }

    private Module? _module;

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => _module?.ToBreadrumbs() ?? new List<BreadcrumbItem>();
    
    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo(_module?.ToLink() + $"?tabIndex={index}");
    }

    protected override async Task OnInitializedAsync()
    {
        _module = await Db.Modules
            .AsNoTracking()
            .Include(m => m.Repository)
            .ThenInclude(r => r.Organisation)
            .Include(m => m.OperationRuns)
            .SingleOrDefaultAsync(m => m.Id == Id && m.RepositoryId == RepoId);
    }
}
