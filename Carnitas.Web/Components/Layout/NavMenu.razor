@inject AuthenticationStateProvider AuthState

<MudNavMenu Margin="Margin.Normal" Rounded="true" Elevation="4">
    @* @if (IsOpen) *@
    @* { *@
    @*     <MudDrawerHeader> *@
    @*         <MudText Typo="Typo.h6">My App</MudText> *@
    @*     </MudDrawerHeader> *@
    @* } *@
    @* <MudDivider Class="my-2"/> *@
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Dashboard</MudNavLink>
    @* <MudNavLink Href="/servers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Computer">Servers</MudNavLink> *@
    <MudNavLink Href="/org" Match="NavLinkMatch.Prefix" Icon="@Constants.OrgIcon">Orgs</MudNavLink>
    <MudNavLink Href="/repo" Match="NavLinkMatch.Prefix" Icon="@Constants.RepoIcon">Repos</MudNavLink>
    <MudNavLink Href="/task" Match="NavLinkMatch.Prefix" Icon="@Constants.OpIcon">Tasks</MudNavLink>
    <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
    @if (_authState?.User.IsInRole("Admin") ?? false)
    {
        <MudNavLink Href="/admin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudNavLink>
    }
    @* <MudNavGroup Title="Settings" Expanded="true" Icon="@Icons.Material.Filled.Settings"> *@
    @*     <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">Users</MudNavLink> *@
    @*     <MudNavLink Href="/security" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Security">Security</MudNavLink> *@
    @* </MudNavGroup> *@
    @* <MudNavLink Href="/about" Match="NavLinkMatch.Prefix">About</MudNavLink> *@
</MudNavMenu>

@code {
    [Parameter] public bool IsOpen { get; set; }
    private AuthenticationState? _authState;

    protected override async Task OnInitializedAsync()
    {
        _authState = await AuthState.GetAuthenticationStateAsync();
    }
}