<div class="d-flex" style="@DivStyle">
    <i class="@Classes" style="@IStyle"></i>
</div>

@code {
    [Parameter] public required string Specifiers { get; set; }

    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;
    [Parameter] public bool SpreadDiv { get; set; }

    private string DivStyle => SpreadDiv ? "margin: auto; text-align: center" : "text-align: center";
    private string IStyle => SpreadDiv ? $"margin: auto; {Style}" : Style;

    private string Classes => string.Join(' ', Specifiers.Split(',').Select(s => "fa-" + s)) + Class;
}