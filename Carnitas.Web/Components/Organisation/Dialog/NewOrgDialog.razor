@using Carnitas.Web.Model
@inject ApplicationDbContext DbContext
<MudDialog>
    <TitleContent>
        Create Organisation
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem>
                <MudCard>
                    <MudCardContent>
                        <MudTextField Label="Name" HelperText="Max. 8 characters"
                                      @bind-Value="_model.Name" For="@(() => _model.Name)"/>
                        <MudTextField Label="Description" Lines="3"
                                      @bind-Value="_model.Description" For="@(() => _model.Description)"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" OnClick="@OnSubmit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    readonly NewOrganisation _model = new();

    private async Task OnSubmit()
    {
        var org = new Organisation
        {
            Id = Guid.NewGuid().ToString(),
            Name = _model.Name,
            Description = _model.Description ?? ""
        };

        DbContext.Organisations.Add(org);
        await DbContext.SaveChangesAsync();

        MudDialog.Close(DialogResult.Ok(org));
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();

}