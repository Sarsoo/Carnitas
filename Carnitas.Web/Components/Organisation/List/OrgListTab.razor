@using Carnitas.Web.Components.Organisation.Dialog
@using Microsoft.EntityFrameworkCore

@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext

<LoadingWrapper IsLoading="IsLoading">
    <MudToolBar>
        <MudSpacer />
        <MudButton @onclick="OpenDialogAsync" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Create" Color="Color.Primary">Create</MudButton>
    </MudToolBar>
    <MudGrid Justify="Justify.Center">
        @foreach (var org in _organisations)
        {
            var orgHref = $"/Org/{org.Id}";
            <MudItem>
                <MudCard>
                    <MudCardContent>
                        <MudText>@org.Name</MudText>
                        <MudText Typo="Typo.body2">@org.Description</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href=@orgHref>Open</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</LoadingWrapper>

@code {

    private IEnumerable<Organisation> _organisations = Enumerable.Empty<Organisation>();
    private bool IsLoading = true;
    
    protected override async Task OnInitializedAsync()
    {
        _organisations = await DbContext.Organisations.ToListAsync();
        IsLoading = false;
    }
    
    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<NewOrgDialog>("Create Organisation", options);
        var result = await dialog.Result;

        if (result is null || result is { Canceled: true } || result.Data is not Organisation org)
        {
            return;
        }

        Navigation.NavigateTo(org.ToLink());
    }
}