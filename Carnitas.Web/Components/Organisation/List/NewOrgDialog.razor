@using Carnitas.Model
@using Carnitas.Model.Governance
@using Carnitas.Web.Model
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
<MudDialog>
    <TitleContent>
        Create Organisation
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem>
                <MudCard>
                    <MudCardContent>
                        <MudTextField Label="Name" HelperText="Max. 8 characters"
                                      @bind-Value="model.Name" For="@(() => model.Name)"/>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" OnClick="@OnSubmit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    NewOrganisation model = new();
    EditForm form;

    private async Task OnSubmit()
    {
        var org = new Organisation
        {
            Id = Guid.NewGuid().ToString(),
            Name = model.Name
        };

        DbContext.Organisations.Add(org);
        await DbContext.SaveChangesAsync();

        MudDialog.Close(DialogResult.Ok(org));
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Cancel() => MudDialog.Cancel();

}