@page "/Org/{id}"
@using Carnitas.Model
@using Carnitas.Model.Governance
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>@org?.Name</h3>

@if (org is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudTabs Elevation="2" Rounded="true" Position="Position.Start" ApplyEffectsToContainer="true" TabPanelsClass="pa-6"  ActivePanelIndex="@TabIndex" ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <OrgOverviewCard Organisation=@org />
        </MudTabPanel>
        <MudTabPanel Text="Repos">
            <OrgReposCard Organisation=@org />
        </MudTabPanel>
        <MudTabPanel Text="Settings">
            <OrgSettingsCard Organisation=@org Saved="ReloadOrg" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private Organisation? org;

    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo(org?.ToLink() + $"?tabIndex={index}");
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadOrg();
    }

    private async Task ReloadOrg()
    {
        org = await Db.Organisations
            .Include(o => o.Repositories)
            .SingleOrDefaultAsync(o => o.Id == Id);
    }
}
