@using Carnitas.Model
@using Carnitas.Model.Governance
@using Carnitas.Model.Source.SourceControl
@using Carnitas.Web.Components.Repository
@using Carnitas.Web.Components.Repository.Dialog
@using Carnitas.Web.Components.Repository.List
@using Carnitas.Web.Extensions
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudGrid>
    <MudItem xs="12">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Create"
                   Color="Color.Primary" OnClick="@OpenNewRepoDialogAsync">Add Repository</MudButton>
    </MudItem>
    <MudItem xs="12">
        <MudDataGrid T="Repository" @ref="_elementGrid" Items="Repositories" RowClick="OnRowClick" Hover="true" Dense="true" RowClass="cursor-pointer">
            <Columns>
                <PropertyColumn Property="x => x.Name"/>
                <PropertyColumn Property="x => x.Type"/>
                <PropertyColumn Property="x => x.Description"/>
                <TemplateColumn>
                    <CellTemplate>
                        @{ var repoLink = $"/Repo/{context.Item.Id}"; }
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                                       Href=@repoLink/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private MudDataGrid<Repository> _elementGrid = null!;
    
    [Parameter] public required Organisation Organisation { get; set; }

    private IQueryable<Repository> Repositories => DbContext.Repository
        .Where(r => r.OrganisationId == Organisation.Id)
        .OrderBy(r => r.Name);

    void OnRowClick(DataGridRowClickEventArgs<Repository> args)
    {
        NavigationManager.NavigateTo(args.ToLink());
    }

    private async Task OpenNewRepoDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters { { "OrganisationId", Organisation.Id } };

        var dialog = await DialogService.ShowAsync<NewRepoDialog>("Add Repository", parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not Repository repo)
        {
            return;
        }

        Organisation.Repositories.Add(repo);
        await _elementGrid.ReloadServerData();
    }
}