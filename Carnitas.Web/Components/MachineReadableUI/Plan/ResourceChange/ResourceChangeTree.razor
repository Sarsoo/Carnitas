@using Sarsoo.Terraform.JsonOutput.Plan
@using Sarsoo.Terraform.MachineReadableUI

<MudTreeView T="ResourceChange" Items="_items" Class="pa-5" ExpandOnClick="true">
    <ItemTemplate>
        <MudTreeViewItem Items="@context.Children"
                         Value="@context.Value"
                         Text="@context.Text"
                         Icon="@context.Icon"
                         IconColor="@ResourceChangeTreeModel.GetColour(context.Value)"
                         EndText="@ResourceChangeTreeModel.GetActionText(context.Value)"
                         EndTextTypo="Typo.caption"
                         Expanded="@context.Expanded"
                         />
    </ItemTemplate>
</MudTreeView>

@code {
    [Parameter] public required PlanRepresentation Plan { get; set; }

    private IReadOnlyList<TreeItemData<ResourceChange>> _items = [];
    private PlanRepresentation? _builtFor;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_builtFor, Plan))
        {
            return;
        }

        _builtFor = Plan;
        _items = ResourceChangeTreeModel.Build(Plan.ToResourceChangeTree());
    }

}
