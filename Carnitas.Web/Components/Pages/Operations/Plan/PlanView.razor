@page "/Task/Plan/{id}"
@using System.Text.Json
@using Carnitas.Job
@using Carnitas.Web.Components.Operations.Plan.Detail
@using Microsoft.EntityFrameworkCore
@using Sarsoo.Terraform.JsonOutput
@using Sarsoo.Terraform.JsonOutput.Plan
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>Plan</h3>

<LoadingWrapper IsLoading="IsLoading">
    @if (_log is null)
    {
        <MudText>Not found</MudText>
    }
    else
    {
        <MudBreadcrumbs Items="Breadcrumbs"/>
        <MudTabs Elevation="2"
                 Rounded="true"
                 Position="Position.Start"
                 ApplyEffectsToContainer="true"
                 TabPanelsClass="px-6"
                 ActivePanelIndex="@TabIndex"
                 ActivePanelIndexChanged="@OnTabChanged">
            <MudTabPanel Text="Overview">
                
            </MudTabPanel>
            <MudTabPanel Text="Planned Values" Icon="@Icons.Material.Filled.ReadMore">
                <ModuleRepresentationTab Module="@_plan.PlannedValues.RootModule"/>
            </MudTabPanel>
            <MudTabPanel Text="Changes" Icon="@Icons.Material.Filled.ReadMore">
                <PlanChangesTab Plan="_plan"/>
            </MudTabPanel>
        </MudTabs>
    }
</LoadingWrapper>

@code {
    /// <summary>
    /// Operation Id (not the operation log entry)
    /// </summary>
    [Parameter]
    public required string Id { get; set; }
    private bool IsLoading = true;
    
    private OperationRunLogEntry? _log;
    private PlanRepresentation? _plan;

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => _log?.ToBreadrumbs("Plan") ?? new List<BreadcrumbItem>();

    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;
    
    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo(_log?.OperationRunId?.OperationIdToPlanLink() + $"?tabIndex={index}");
    }
    

    protected override async Task OnInitializedAsync()
    {
        _log = await Db.OperationRunLogEntries
            .AsNoTracking()
            .IncludeOrgHierarchy()
            .SingleOrDefaultAsync(r => r.OperationRunId == Id && r.Type == LogType.PlanJson);

        if (_log is not null && _log.Payload.Deserialize<PlanRepresentation>(JsonOutputContext.Default.PlanRepresentation) is { } plan)
        {   
            _plan = plan;
        }

        IsLoading = false;
    }
}
