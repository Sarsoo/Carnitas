@page "/Org/{id}"
@using Carnitas.Web.Components.Organisation.Detail
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>@org?.Name</h3>

@if (org is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"/>
    <MudTabs Elevation="2" 
             Rounded="true" 
             Position="Position.Start" 
             ApplyEffectsToContainer="true" 
             TabPanelsClass="px-6"  
             ActivePanelIndex="@TabIndex" 
             ActivePanelIndexChanged="@OnTabChanged">
        <MudTabPanel Text="Overview">
            <OrgOverviewCard Organisation=@org />
        </MudTabPanel>
        <MudTabPanel Text="Repos" Icon="@Constants.RepoIcon">
            <OrgReposCard Organisation=@org />
        </MudTabPanel>
        <MudTabPanel Text="Settings" Icon="@Constants.SettingsIcon">
            <OrgSettingsCard Organisation=@org Saved="ReloadOrg" />
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public required string Id { get; set; }

    private Organisation? org;
    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => org?.ToBreadrumbs() ?? new List<BreadcrumbItem>();

    [SupplyParameterFromQuery(Name="tabIndex")] public int TabIndex { get; set; } = 0;

    private void OnTabChanged(int index)
    {
        if (TabIndex == index)
        {
            return;
        }

        TabIndex = index;
        Navigation.NavigateTo(org?.ToLink() + $"?tabIndex={index}");
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadOrg();
    }

    private async Task ReloadOrg()
    {
        org = await Db.Organisations
            .Include(o => o.Repositories)
            .SingleOrDefaultAsync(o => o.Id == Id);
    }
}
