@page "/Task/Run/{id}"
@using System.Text.Json
@using Carnitas.Job
@using Microsoft.EntityFrameworkCore
@using Sarsoo.Terraform.JsonOutput
@using Sarsoo.Terraform.JsonOutput.Plan
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>Operation Run</h3>

@if (run is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
    <MudCard Elevation="0" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h5">@run.DisplayString</MudText>
            @* <MudText Typo="Typo.body2">Id: @run.Id</MudText> *@
            <MudText Typo="Typo.body2">Initiated By: @InitiatorLabel(run.InitiatorType, run.InitiatorUser, run.InitiatorUserId)</MudText>
            <MudText Typo="Typo.body2">Started: @(run.StartTime?.ToString() ?? "—")</MudText>
            @if (run.EndTime is not null)
            {
                <MudText Typo="Typo.body2">Ended: @run.EndTime</MudText>
            }
            <ExitCodeChip Code="@run.ExitCode"/>
            @if (run.GitReference is not null)
            {
                <MudText Typo="Typo.body2">Git Reference: @run.GitReference</MudText>
            }
            @if (run.CommitSha is not null)
            {
                <MudText Typo="Typo.body2">Commit: @run.CommitSha</MudText>
            }
            @if (run.LogPath is not null)
            {
                <MudText Typo="Typo.body2">Log: @run.LogPath</MudText>
            }
            @if (run.Checkout is not null)
            {
                <MudText Typo="Typo.body2">Checkout: @run.Checkout.Path</MudText>
            }
            @if (_containsPlan)
            {
                <MudButton Href="@run?.ToPlanLink()">Go to Plan</MudButton>
            }
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6">Log</MudText>
    <RunLogTable OperationId="@Id"/>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private OperationRun? run;
    private bool _containsPlan;

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => run?.ToBreadrumbs() ?? new List<BreadcrumbItem>();

    private static string InitiatorLabel(InitiatorType type, ApplicationUser? user, string? userId) =>
        type == InitiatorType.User
            ? user?.UserName ?? user?.Email ?? userId ?? "Unknown user"
            : "System";

    protected override async Task OnInitializedAsync()
    {
        run = await Db.OperationRuns
            .AsNoTracking()
            .Include(r => r.Module)
            .ThenInclude(m => m.Repository)
            .ThenInclude(r => r.Organisation)
            .Include(r => r.Checkout)
            .Include(r => r.InitiatorUser)
            .Include(r => r.QueuedTask)
            .SingleOrDefaultAsync(r => r.Id == Id);

        _containsPlan = (await Db.OperationRunLogEntries.CountAsync(x => x.OperationRunId == Id && x.Type == LogType.PlanJson) > 0);
    }
}
