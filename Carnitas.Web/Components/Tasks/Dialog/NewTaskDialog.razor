@using Carnitas.Model
@using Carnitas.Model.Identity
@using Carnitas.Model.Operations
@using Carnitas.Model.Source
@using Carnitas.Model.Source.SourceControl
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject ITaskQueue TaskQueue
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<MudDialog>
    <TitleContent>
        Enqueue Task
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string" Label="Repository" @bind-Value="_repositoryId"
                           @bind-Value:after="OnRepositoryChanged">
                    @foreach (var repository in _repositories)
                    {
                        <MudSelectItem Value="@repository.Id">@repository.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" Label="Module" @bind-Value="_moduleId">
                    @foreach (var module in _modules)
                    {
                        <MudSelectItem Value="@module.Id">@module.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (!_discover)
            {
                <MudItem xs="12">
                    <MudTextField Label="Git Reference" @bind-Value="_gitReference"
                                  HelperText="Branch, tag, or commit SHA. Leave blank for the default branch."/>
                </MudItem>
            }
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Operations</MudText>
                <MudCheckBox T="bool" Label="Init" @bind-Value="_init"/>
                <MudCheckBox T="bool" Label="Plan" @bind-Value="_plan"/>
                <MudCheckBox T="bool" Label="Apply" @bind-Value="_apply"/>
                <MudCheckBox T="bool" Label="Discover Sources" @bind-Value="_discover"
                             HelperText="Scans the repository for Terraform root modules. Runs on its own."/>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="int" Label="Priority" @bind-Value="_priority"/>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Disabled="@(!CanSubmit)" OnClick="Submit">Enqueue</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string? RepositoryId { get; set; }

    [Parameter]
    public string? ModuleId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private List<Repository> _repositories = new();
    private List<Module> _modules = new();

    private string? _repositoryId;
    private string? _moduleId;
    private string? _gitReference;
    private bool _init = true;
    private bool _plan = true;
    private bool _apply;
    private bool _discover;
    private int _priority;

    private Module? SelectedModule => _modules.FirstOrDefault(m => m.Id == _moduleId);

    private bool HasUsableModule => !string.IsNullOrWhiteSpace(SelectedModule?.RelativePath);

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_repositoryId)
                              && (_discover
                                  || (HasUsableModule && (_init || _plan || _apply)));

    protected override async Task OnInitializedAsync()
    {
        _repositoryId = RepositoryId;
        _moduleId = ModuleId;

        _repositories = await Db.Repository.OrderBy(r => r.Name).ToListAsync();

        if (!string.IsNullOrWhiteSpace(_repositoryId))
        {
            await LoadModules();
        }
    }

    private async Task OnRepositoryChanged()
    {
        _moduleId = null;
        await LoadModules();
    }

    private async Task LoadModules()
    {
        _modules = await Db.Modules
            .Where(m => m.RepositoryId == _repositoryId)
            .OrderBy(m => m.Name)
            .ToListAsync();
    }

    private async Task Submit()
    {
        var repository = _repositories.Single(r => r.Id == _repositoryId);

        var operations = new List<OperationKind>();
        if (_discover)
        {
            operations.Add(OperationKind.DiscoverSource);
        }
        else
        {
            if (_init)
            {
                operations.Add(OperationKind.Init);
            }

            if (_plan)
            {
                operations.Add(OperationKind.Plan);
            }

            if (_apply)
            {
                operations.Add(OperationKind.Apply);
            }
        }

        var initiatorType = InitiatorType.System;
        string? initiatorUserId = null;

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var userId = UserManager.GetUserId(state.User);
            if (userId is not null)
            {
                initiatorType = InitiatorType.User;
                initiatorUserId = userId;
            }
        }

        var modulePath = _discover ? string.Empty : SelectedModule?.RelativePath ?? string.Empty;

        var task = await TaskQueue.EnqueueAsync(new EnqueueTaskRequest(
            repository.GitUrl,
            modulePath,
            _moduleId,
            operations,
            _priority,
            InitiatorType: initiatorType,
            InitiatorUserId: initiatorUserId,
            RepositoryId: _repositoryId,
            GitReference: string.IsNullOrWhiteSpace(_gitReference) ? null : _gitReference.Trim()));

        MudDialog.Close(DialogResult.Ok(task));
    }

    private void Cancel() => MudDialog.Cancel();
}
