@page "/Task/{id}"
@using Carnitas.Model
@using Carnitas.Model.Identity
@using Carnitas.Model.Operations
@using Carnitas.Web.Extensions
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<h3>Queued Task</h3>

@if (task is null)
{
    <MudText>Not found</MudText>
}
else
{
    <MudBreadcrumbs Items="Breadcrumbs"></MudBreadcrumbs>
    <MudCard Elevation="0" Class="mb-4">
        <MudCardContent>
            <MudStack Row="true">
                <MudContainer>
                    <MudText Typo="Typo.h5">@task.Module?.Name</MudText>
                    <MudText Typo="Typo.body2">State: @task.State</MudText>
                    <MudText Typo="Typo.body2">Repository: @task.RepoUrl</MudText>
                    <MudText Typo="Typo.body2">Module Path: @task.ModulePath</MudText>
                    <MudText Typo="Typo.body2">Initiated By: @InitiatorLabel(task.InitiatorType, task.InitiatorUser, task.InitiatorUserId)</MudText>
                    <MudText Typo="Typo.body2">Priority: @task.Priority</MudText>
                    <MudText Typo="Typo.body2">Attempts: @task.Attempts / @task.MaxAttempts</MudText>
                    <MudText Typo="Typo.body2">Scheduled: @task.ScheduledAt</MudText>
                    <MudText Typo="Typo.body2">Created: @task.CreatedAt</MudText>
                    @if (task.StartedAt is not null)
                    {
                        <MudText Typo="Typo.body2">Started: @task.StartedAt</MudText>
                    }
                    @if (task.CompletedAt is not null)
                    {
                        <MudText Typo="Typo.body2">Completed: @task.CompletedAt</MudText>
                    }
                    @if (task.LockedBy is not null)
                    {
                        <MudText Typo="Typo.body2">Locked By: @task.LockedBy</MudText>
                        <MudText Typo="Typo.body2">Locked Until: @task.LockedUntil</MudText>
                    }
                    @if (task.LastError is not null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">Error: @task.LastError</MudText>
                    }
                </MudContainer>
                <MudContainer>
                    <MudTimeline>
                        @foreach (var (i, op) in task.Operations.Select((o, i) => (i, o)))
                        {
                            <MudTimelineItem>
                                <MudText
                                    Align="(i % 2) == 0 ? Align.Start : Align.End">
                                    @op.Kind
                                </MudText>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudContainer>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.h6">Operations</MudText>
    <MudTable Items="@task.Operations.OrderBy(o => o.Sequence)" Dense="true" Hover="true" Class="mt-2">
        <HeaderContent>
            <MudTh>Sequence</MudTh>
            <MudTh>Operation</MudTh>
            <MudTh>Operation Id</MudTh>
            <MudTh>Run</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Sequence</MudTd>
            <MudTd>@context.Kind</MudTd>
            <MudTd>@context.Id</MudTd>
            <MudTd>
                @if (runs.Any(r => r.Id == context.Id))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Href=@context.ToLink()/>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h6" Class="mt-4">Runs</MudText>
    <MudTable Items="@runs" Dense="true" Hover="true" Class="mt-2">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Started</MudTh>
            <MudTh>Ended</MudTh>
            <MudTh>Exit Code</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.GetType().Name</MudTd>
            <MudTd>@(context.StartTime?.ToString() ?? "—")</MudTd>
            <MudTd>@(context.EndTime?.ToString() ?? "—")</MudTd>
            <MudTd>@context.ExitCode?.ToString()</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Href=@context.ToLink()/>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private QueuedTask? task;
    private List<OperationRun> runs = new();

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs => task?.ToBreadrumbs() ?? new List<BreadcrumbItem>();

    private static string InitiatorLabel(InitiatorType type, ApplicationUser? user, string? userId) =>
        type == InitiatorType.User
            ? user?.UserName ?? user?.Email ?? userId ?? "Unknown user"
            : "System";

    protected override async Task OnInitializedAsync()
    {
        task = await Db.QueuedTasks
            .Include(t => t.Module)
            .ThenInclude(m => m.Repository)
            .ThenInclude(r => r.Organisation)
            .Include(t => t.Operations)
            .Include(t => t.InitiatorUser)
            .SingleOrDefaultAsync(t => t.Id == Id);

        if (task is not null)
        {
            runs = await Db.OperationRuns
                .Where(r => r.QueuedTaskId == task.Id)
                .OrderBy(r => r.StartTime)
                .ToListAsync();
        }
    }
}
