@using System.Text.Json
@using Carnitas.Job
@using Microsoft.EntityFrameworkCore
@using Sarsoo.Terraform.MachineReadableUI
@using Sarsoo.Terraform.MachineReadableUI.Json
@inject ApplicationDbContext Db

<MudTable Items="@logEntries" Dense="true" Hover="true" Class="mt-2">
    <HeaderContent>
        <MudTh>Timestamp</MudTh>
        <MudTh>Log</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Item1.Timestamp</MudTd>
        <MudTd>@GetLogLine(context)</MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public string OperationId { get; set; }
    private List<(OperationRunLogEntry, TerraformMessage?)> logEntries = new();
    
    protected override async Task OnInitializedAsync()
    {
        var dbLogs = Db.OperationRunLogEntries
            .AsNoTracking()
            .Where(e => e.OperationRunId == OperationId)
            .OrderBy(e => e.Sequence)
            .ToList();
            // .Select(x => (x, x.Payload.Deserialize<TerraformMessage>(MruiContext.Default.TerraformMessage))).ToList();
            
        var terraformMessages = new List<(OperationRunLogEntry, TerraformMessage?)>();

        foreach (var log in dbLogs)
        {
            if (log.Type is LogType.Json && log.Payload.Deserialize<TerraformMessage>(MruiContext.Default.TerraformMessage) is { } message)
            {
                terraformMessages.Add((log, message));
            }
        }
        
        logEntries = terraformMessages;
    }

    private string GetLogLine((OperationRunLogEntry, TerraformMessage?) log)
    {
        if (log.Item2 is not null)
        {
            return log.Item2.Message;
        }
        else
        {
            return log.Item1.Payload.GetRawText();
        }
    }
}