{
  "Backend": {
    "Url": "http://localhost:5001"
  },
  "Worker": {
    "Name": "Worker1"
  },

  "NLog": {
    "rules": [
      {
        "final": true,
        "logger": "Microsoft.AspNetCore.*",
        "maxLevel": "Info"
      },
      {
        "final": true,
        "logger": "System.Net.Http.*",
        "maxLevel": "Off"
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logconsole"
      }
    ],
    "targets": {
      "async": true,
      "logconsole": {
        "type": "ColoredConsole",
        "layout": "${longdate}|${event-properties:item=EventId_Id:whenEmpty=0}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}|${scopenested}",
        "rowHighlightingRules": [
          {
            "condition": "level == LogLevel.Error",
            "foregroundColor": "Red"
          },
          {
            "condition": "level == LogLevel.Fatal",
            "foregroundColor": "Red",
            "backgroundColor": "White"
          }
        ]
      }
    },
    "throwConfigExceptions": true
  }
}